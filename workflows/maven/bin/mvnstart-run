#!/usr/bin/env bash
# mvnstart-run 入口，等价于 mvnstart run。共用机制在 ../lib/mvnstart-core.sh。
set -uo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
lib="${self%/bin/*}/lib/mvnstart-core.sh"
[[ -f "$lib" ]] || { printf 'mvnstart-run: 找不到 %s\n' "$lib" >&2; exit 1; }

MVNSTART_DEFAULT_COMMAND='run'
# shellcheck source=../lib/mvnstart-core.sh
source "$lib"
main "$@"
