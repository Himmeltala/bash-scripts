#!/usr/bin/env bash
# cleanx 入口，核心在 ../lib/cleanx-core.sh。
set -uo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
lib="${self%/bin/*}/lib/cleanx-core.sh"
[[ -f "$lib" ]] || { printf 'cleanx: 找不到 %s\n' "$lib" >&2; exit 1; }

# shellcheck source=../lib/cleanx-core.sh
source "$lib"
main "$@"
