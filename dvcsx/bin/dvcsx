#!/usr/bin/env bash
# dvcsx 入口，默认起网页界面，共用机制在 ../lib/dvcsx-core.sh。
set -uo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
lib="${self%/bin/*}/lib/dvcsx-core.sh"
[[ -f "$lib" ]] || { printf 'dvcsx: 找不到 %s\n' "$lib" >&2; exit 1; }

# shellcheck source=../lib/dvcsx-core.sh
source "$lib"
main "$@"
