#!/usr/bin/env bash
# mvnx 入口，默认执行 run，共用机制在 ../lib/mvnx-core.sh。
set -uo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
lib="${self%/bin/*}/lib/mvnx-core.sh"
[[ -f "$lib" ]] || { printf 'mvnx: 找不到 %s\n' "$lib" >&2; exit 1; }

# shellcheck source=../lib/mvnx-core.sh
source "$lib"
main "$@"
