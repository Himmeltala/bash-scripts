#!/usr/bin/env bash
# nodex 入口，默认执行 dev，共用机制在 ../lib/nodex-core.sh。
set -uo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 1
lib="${self%/bin/*}/lib/nodex-core.sh"
[[ -f "$lib" ]] || { printf 'nodex: 找不到 %s\n' "$lib" >&2; exit 1; }

# shellcheck source=../lib/nodex-core.sh
source "$lib"
main "$@"
